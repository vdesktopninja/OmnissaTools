<Window x:Class="LogScrub.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="LogScrub - Log Anonymization Tool" 
        Height="700" Width="1100"
        Icon="icon.ico"
        WindowState="Maximized"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragOver"
        DragLeave="Window_DragLeave"
        Drop="Window_Drop"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <materialDesign:DialogHost Identifier="RootDialog">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <materialDesign:Card Grid.Row="0" Margin="0,0,0,20" Padding="24,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource MaterialDesignHeadline4TextBlock}" 
                               Text="LogScrub" 
                               Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                    <TextBlock Style="{StaticResource MaterialDesignBody2TextBlock}" 
                               Text="Professional Log Anonymization Tool"
                               Opacity="0.8"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- File Paths -->
            <materialDesign:Card Grid.Row="1" Margin="0,0,0,16" Padding="24,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Input Path -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBox x:Name="InputBox" 
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="Input Folder or ZIP File"
                                 materialDesign:HintAssist.IsFloating="True"
                                 Text="{Binding InputPath}"/>
                        
                        <Button Grid.Column="2" 
                                Content="BROWSE FOLDER"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Click="BrowseInput_Click"
                                Margin="0,0,8,0"/>
                        
                        <Button Grid.Column="3" 
                                Content="BROWSE ZIP"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Click="BrowseZip_Click"/>
                    </Grid>

                    <!-- Output Path -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBox x:Name="OutputBox" 
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="Output Path"
                                 materialDesign:HintAssist.IsFloating="True"
                                 Text="{Binding OutputPath}"/>
                        
                        <Button Grid.Column="2" 
                                Content="SELECT"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Click="BrowseOutput_Click"/>
                    </Grid>
                </Grid>
            </materialDesign:Card>

            <!-- Anonymization Options -->
            <materialDesign:Card Grid.Row="2" Margin="0,0,0,16" Padding="24,20">
                <StackPanel>
                    <TextBlock Style="{StaticResource MaterialDesignHeadline6TextBlock}" 
                               Text="Anonymization Options" 
                               Margin="0,0,0,16"/>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Left Column -->
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <CheckBox x:Name="AnonymizeIpCheckBox" 
                                      Content="Anonymize IP Addresses" 
                                      Style="{StaticResource MaterialDesignCheckBox}"
                                      IsChecked="{Binding AnonymizeIPs}"
                                      Margin="0,0,0,12"/>
                            
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="IP Mode:" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <ComboBox x:Name="IpModeBox" 
                                          Grid.Column="1"
                                          Style="{StaticResource MaterialDesignComboBox}"
                                          ItemsSource="{Binding AvailableIpModes}" 
                                          SelectedValue="{Binding IpMode}"/>
                            </Grid>
                            
                            <CheckBox x:Name="KeepRfc1918CheckBox" 
                                      Content="Keep RFC1918 Private IPs" 
                                      Style="{StaticResource MaterialDesignCheckBox}"
                                      IsChecked="{Binding KeepRfc1918}"
                                      Margin="0,0,0,12"/>
                        </StackPanel>
                        
                        <!-- Right Column -->
                        <StackPanel Grid.Column="1">
                            <CheckBox x:Name="AnonymizeFqdnCheckBox" 
                                      Content="Anonymize Domain Names" 
                                      Style="{StaticResource MaterialDesignCheckBox}"
                                      IsChecked="{Binding AnonymizeFqdns}"
                                      Margin="0,0,0,12"/>
                            
                            <CheckBox x:Name="AnonymizeUsersCheckBox" 
                                      Content="Anonymize Usernames" 
                                      Style="{StaticResource MaterialDesignCheckBox}"
                                      IsChecked="{Binding AnonymizeUsers}"
                                      Margin="0,0,0,12"/>
                            
                            <CheckBox x:Name="AnonymizeServersCheckBox" 
                                      Content="Anonymize Servers/Hostnames" 
                                      Style="{StaticResource MaterialDesignCheckBox}"
                                      IsChecked="{Binding AnonymizeServers}"
                                      Margin="0,0,0,12"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </materialDesign:Card>

            <!-- Advanced Options -->
            <materialDesign:Card Grid.Row="3" Margin="0,0,0,16" Padding="24,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0"
                               Style="{StaticResource MaterialDesignHeadline6TextBlock}" 
                               Text="Advanced Settings"/>
                    
                    <!-- Target Domain -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBox x:Name="TargetDomainBox" 
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="Target Domain (optional)"
                                 materialDesign:HintAssist.IsFloating="True"
                                 materialDesign:HintAssist.HelperText="e.g., company.local"
                                 Text="{Binding TargetDomain}"/>
                        
                        <TextBlock Grid.Column="1" 
                                   Text="Enhanced detection for usernames, hostnames, and domain-specific patterns"
                                   Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                   VerticalAlignment="Center"
                                   Margin="16,0,0,0"
                                   Opacity="0.8"/>
                    </Grid>
                    
                    <!-- Parallelism -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Text="Parallelism:" VerticalAlignment="Center"/>
                        
                        <Slider x:Name="ParallelismSlider" 
                                Grid.Column="1"
                                Minimum="1" Maximum="32" 
                                Style="{StaticResource MaterialDesignSlider}"
                                Value="{Binding Parallelism}"
                                Margin="16,0"/>
                        
                        <TextBlock x:Name="ParallelismLabel" 
                                   Grid.Column="2"
                                   Text="{Binding Parallelism, StringFormat={}{0:0}}" 
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   FontWeight="Medium"/>
                        
                        <Button x:Name="StartBtn" 
                                Grid.Column="4"
                                Content="START PROCESSING"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Command="{Binding StartProcessingCommand}" 
                                IsEnabled="{Binding CanStartProcessing}"
                                Margin="0,0,8,0"/>
                        
                        <Button x:Name="CancelBtn" 
                                Grid.Column="5"
                                Content="CANCEL"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding CancelProcessingCommand}" 
                                IsEnabled="{Binding CanCancelProcessing}"
                                Margin="0,0,8,0"/>
                        
                        <Button x:Name="OpenOutputBtn" 
                                Grid.Column="6"
                                Content="OPEN OUTPUT"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding OpenOutputCommand}" 
                                IsEnabled="{Binding CanOpenOutput}"/>
                    </Grid>
                </Grid>
            </materialDesign:Card>

            <!-- Progress and Log -->
            <materialDesign:Card Grid.Row="4" Padding="24,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Style="{StaticResource MaterialDesignHeadline6TextBlock}" 
                               Text="Processing Status"/>
                    
                    <ProgressBar x:Name="ProgressBar" 
                                 Grid.Row="2"
                                 Height="8" 
                                 Style="{StaticResource MaterialDesignLinearProgressBar}"
                                 Minimum="0" Maximum="100" 
                                 Value="{Binding ProgressPercentage}"/>
                    
                    <TextBlock x:Name="ProgressLbl" 
                               Grid.Row="4"
                               Text="{Binding ProgressMessage}"
                               Style="{StaticResource MaterialDesignBody2TextBlock}"/>
                    
                    <ScrollViewer Grid.Row="6" 
                                  VerticalScrollBarVisibility="Auto"
                                  materialDesign:ScrollViewerAssist.IsAutoHideEnabled="True">
                        <ItemsControl ItemsSource="{Binding LogMessages}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" 
                                               FontFamily="Consolas" 
                                               FontSize="12" 
                                               TextWrapping="Wrap"
                                               Margin="0,2"
                                               Style="{StaticResource MaterialDesignCaptionTextBlock}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </materialDesign:Card>

            <!-- Footer -->
            <Grid Grid.Row="5" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Text="Made by vdesktop.ninja"
                           Style="{StaticResource MaterialDesignCaptionTextBlock}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Opacity="0.6"/>
                           
                <TextBlock Grid.Column="1"
                           Text="v1.0.0"
                           Style="{StaticResource MaterialDesignCaptionTextBlock}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Opacity="0.6"/>
            </Grid>

            <!-- Drag & Drop Overlay -->
            <Border x:Name="DropHint" Grid.RowSpan="6" Visibility="Collapsed"
                    Background="{DynamicResource PrimaryHueLightBrush}" 
                    Opacity="0.9"
                    BorderBrush="{DynamicResource PrimaryHueMidBrush}" 
                    BorderThickness="3"
                    CornerRadius="8" 
                    Panel.ZIndex="999">
                <Grid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="CloudUpload" 
                                                 Width="64" Height="64"
                                                 Foreground="{DynamicResource PrimaryHueDarkBrush}"
                                                 HorizontalAlignment="Center"
                                                 Margin="0,0,0,16"/>
                        <TextBlock Text="Drop folder or ZIP file here"
                                   Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryHueDarkBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </materialDesign:DialogHost>
</Window>